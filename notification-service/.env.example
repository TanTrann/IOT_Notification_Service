PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/notifications_db

# Firebase credentials
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Nhận thông báo từ Phong qua HTTP: Phong POST /internal/notify (kèm header x-api-key).
# Không còn nghe MQTT — service chỉ nhận tin Phong đã xử lý rồi đẩy FCM lên màn hình.

# deviceId mặc định cho script test (scripts/publish-test.js) khi không truyền tham số.
DEFAULT_DEVICE_ID=ESP32S3_Zone1
# URL service để script test gọi tới (mặc định http://localhost:<PORT>).
# TEST_SERVICE_URL=http://localhost:3001

# API key CHỈ dành cho server Phong gọi POST /internal/notify (header x-api-key).
# Đặt chuỗi ngẫu nhiên đủ dài, cấp cho Phong qua kênh riêng. Web/app người dùng KHÔNG dùng key này.
INTERNAL_API_KEY=change_me_to_a_random_secret

# Server .NET của Phong — nguồn tài khoản + quyền xem cây. /api/v1/* xác thực người dùng bằng JWT của Phong
# bằng cách gọi GET {PLANT_API_URL}/api/devices. Thiếu biến này → /api/v1/* trả 503 và không gửi push cho ai.
# dotnet run = 8000; Docker deploy = 8080.
PLANT_API_URL=http://localhost:8000
# Thời gian (giây) nhớ tạm kết quả hỏi quyền từ Phong. Thu hồi/thêm share có hiệu lực trong khoảng này.
AUTH_CACHE_SECONDS=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:3003
